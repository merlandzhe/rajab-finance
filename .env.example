NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only service role: notification worker, public intake and verified Telegram auth ONLY
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_TENANT_ID=
APP_ORIGIN=http://localhost:3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRON_SECRET=

# Separate working deployment only; never enable for the approved hosted demo.
# Apply the Telegram migration and configure a separate RAJAB bot first.
TELEGRAM_MINI_APP_ENABLED=true
TELEGRAM_MINI_APP_BOT_USERNAME=RajabFinance_bot
# Server secret. Never prefix with NEXT_PUBLIC or put it in chat/source control.
TELEGRAM_MINI_APP_BOT_TOKEN=

# Buyer platform. Keep off until the buyer migration and webhook are deployed.
TELEGRAM_SELF_SIGNUP_ENABLED=false
# Random server-only value, 32+ characters, used by Telegram setWebhook secret_token.
TELEGRAM_WEBHOOK_SECRET=
# Enables actual messages to linked Telegram accounts; never enable in local demos.
TELEGRAM_NOTIFICATIONS_ENABLED=false
